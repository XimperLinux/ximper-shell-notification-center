{
  "$schema": @JSONPATH@,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "notification-daemon": true,
  "control-center-width": 400,
  "control-center-height": 740,
  "control-center-dynamic-height": true,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-inline-replies": false,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "notification-history-limit": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "widgets": [
    "backlight",
    "volume",
    "quick-settings",
    "inhibitors",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "quick-settings": {
      "tiles": [
        { "type": "wifi" },
        { "type": "vpn" },
        { "type": "bluetooth" },
        { "type": "power-profiles" },
        { "type": "dnd" },
        { "type": "dark-mode" },
        { "type": "night-light" },
        { "type": "caffeine" }
      ]
    }
  }
}
